# Optional local Iceberg source checkout.
ICEBERG_SOURCE_DIR=../iceberg

# Stable release Javadoc is the default.
ICEBERG_JAVADOC_VERSION=1.11.0
# ICEBERG_JAVADOC_BASE_URL=https://iceberg.apache.org/javadoc/

# Optional REST Catalog. Mutations remain disabled unless explicitly enabled.
# ICEBERG_CATALOG_URI=https://catalog.example.com
# ICEBERG_CATALOG_WAREHOUSE=warehouse-name
# ICEBERG_CATALOG_TOKEN_FILE=/run/secrets/iceberg_catalog_token
# Or use an explicit external OAuth endpoint and client_id:client_secret file.
# ICEBERG_OAUTH2_URI=https://identity.example.com/oauth/token
# ICEBERG_OAUTH2_CREDENTIAL_FILE=/run/secrets/iceberg_oauth_credential
# ICEBERG_CATALOG_ALLOW_MUTATIONS=false

# stdio is the safe default. HTTP binds to loopback unless explicitly changed.
ICEBERG_MCP_TRANSPORT=stdio
# ICEBERG_MCP_HOST=127.0.0.1
# ICEBERG_MCP_PORT=3000
# ICEBERG_MCP_MAX_REQUEST_BYTES=1048576
# ICEBERG_MCP_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# ICEBERG_MCP_AUTH_TOKEN_FILE=/run/secrets/iceberg_mcp_token

# Shared upstream and output limits.
# ICEBERG_REQUEST_TIMEOUT_MS=15000
# ICEBERG_MAX_RESPONSE_CHARS=30000

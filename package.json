{
  "name": "iceberg-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for Apache Iceberg Java API intelligence and REST Catalog operations",
  "type": "module",
  "bin": {
    "iceberg-mcp-server": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    ".env.example",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "dist",
    "docs",
    "evaluations/README.md",
    "evaluations/evaluations.xml",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "clean": "node scripts/clean.mjs",
    "dev": "tsx src/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "prepack": "npm run clean && npm run check",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:evaluations": "npm run build && node evaluations/verify.mjs",
    "verify:clients": "npm run build && node scripts/verify-client-configs.mjs",
    "verify:openapi": "npm run build && node scripts/check-openapi-coverage.mjs ../iceberg/open-api/rest-catalog-open-api.yaml"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "apache-iceberg",
    "iceberg",
    "mcp",
    "model-context-protocol",
    "rest-catalog"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "cheerio": "1.2.0",
    "hono": "4.13.5",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "jiti": "2.7.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  }
}
